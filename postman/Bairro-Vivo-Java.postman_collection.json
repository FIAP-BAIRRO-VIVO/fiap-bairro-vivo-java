{
  "info": {
    "_postman_id": "51b119aa-f71a-4c7a-b06d-fd15f7c42cb7",
    "name": "Bairro Vivo - Java API",
    "description": "Colecao Postman da API Java do Bairro Vivo. Importar este arquivo no Postman e selecionar a variavel baseUrl. O cadastro/login salva accessToken; as requisicoes privadas herdam esse bearer token. A API .NET, Oracle, RabbitMQ e o modelo de IA precisam estar configurados para os fluxos correspondentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "cidadao@example.com",
      "type": "string"
    },
    {
      "key": "senha",
      "value": "troque-esta-senha-123",
      "type": "string"
    },
    {
      "key": "nome",
      "value": "Cidadao de teste",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "localId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "ocorrenciaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orientacaoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "page",
      "value": "0",
      "type": "string"
    },
    {
      "key": "pageSize",
      "value": "10",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Cadastrar cidadao",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.collectionVariables.get('email') || 'cidadao@example.com';",
                  "pm.collectionVariables.set('email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cadastro concluido', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.usuario && body.usuario.id) pm.collectionVariables.set('userId', body.usuario.id);",
                  "pm.test('Cadastro publico recebe papel CIDADAO', function () { pm.expect(body.usuario.papel).to.eql('CIDADAO'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nome}}\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\",\n  \"confirmacaoSenha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/registrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "registrar"
              ]
            },
            "description": "Cria uma conta CIDADAO e salva o accessToken retornado. O email precisa ser unico; ajuste a variavel email antes de repetir o cadastro."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login concluido', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.usuario && body.usuario.id) pm.collectionVariables.set('userId', body.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "JWKS publico",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            }
          },
          "response": []
        }
      ]
    },
